<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 e successivi: la partita a due contiene la chiave privata, non va nei backup né nei trasferimenti. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="multiplayer.json"/>
        <exclude domain="file" path="stile/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="multiplayer.json"/>
        <exclude domain="file" path="stile/"/>
    </device-transfer>
</data-extraction-rules>
