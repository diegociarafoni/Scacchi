# Pubblicazione su Google Play. Nessuna credenziale nel repository: il file JSON
# dell'account di servizio arriva dalla variabile PLAY_SERVICE_ACCOUNT_JSON
# (segreto di GitHub Actions), vedi docs/store.md.
default_platform(:android)

platform :android do
  desc "Controlla che la chiave dell'account di servizio sia valida per Google Play"
  lane :convalida do
    validate_play_store_json_key(json_key_data: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON"))
  end

  desc "Carica un bundle già firmato sulla traccia interna di Google Play, come bozza"
  lane :interna do
    upload_to_play_store(
      track: "internal",
      release_status: "draft",
      aab: ENV.fetch("AAB_PATH", "../build/app/outputs/bundle/release/app-release.aab"),
      json_key_data: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON"),
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end
